{
  "v": 2,
  "size": 256,
  "name": "The Heartwood Vault",
  "description": "Below the hollow gate, amber lights reveal chambers carved through living wood. Lead a small company across the root crown, through the lower gallery, and into the corrupted heart.",
  "mission": {
    "campaign": "vanguard",
    "title": "Mission 5 — The Heartwood Vault",
    "order": 5,
    "company": [
      "marshal",
      "guard-0",
      "guard-1",
      "guard-2",
      "guard-3",
      "archer-0",
      "archer-1",
      "archer-2"
    ],
    "objectives": [
      {
        "id": "gallery",
        "title": "Explore the root gallery",
        "description": "Lead the Marshal into the great chamber. The root crown and the lower gallery are separate paths.",
        "optional": false
      },
      {
        "id": "resin-room",
        "title": "Secure the resin chamber",
        "description": "Defeat both guardians in the eastern amber-lit room.",
        "optional": false
      },
      {
        "id": "heart",
        "title": "Silence the Heart Keeper",
        "description": "Defeat the matriarch and its two guards in the northern vault. Keep the Marshal alive.",
        "optional": false
      },
      {
        "id": "fungal-cache",
        "title": "Search the fungal alcove",
        "description": "Clear the western side chamber to recover a Barkguard.",
        "optional": true
      }
    ],
    "heroLevelCap": 8,
    "script": "function on_start()\n mission.set('stage','gallery');mission.begin_objective('gallery')\n mission.camera('first-person','archer-1','marshal',nil,1.5,55,0.6)\n mission.set('intro-camera',true)\n mission.say('Marshal','unit.ants.marshal','No wind. No sky. Only the tree around us. Keep to the amber lights. We find what poisons these roots, then we find our way home.',10,true, 'marshal')\nend\nfunction on_tick()\n if mission.get('intro-camera') then mission.end_scene();mission.set('intro-camera',nil) end\n if not mission.alive('marshal') then mission.lose();return end\n local stage=mission.get('stage')\n if stage=='gallery' and mission.in_region('marshal','gallery') then\n  mission.complete_objective('gallery');mission.begin_objective('resin-room');mission.set('stage','resin')\n  mission.say('Vanguard scout','unit.ants.archer','The root rises above the gallery. Archers can take its crown while the shields cover the lower passage. I see amber burning in a chamber to the east.',10,true, 'archer-1')\n elseif stage=='resin' and not mission.alive('resin-guard.0') and not mission.alive('resin-guard.1') then\n  mission.complete_objective('resin-room');mission.begin_objective('heart');mission.set('stage','heart')\n  mission.recover('marshal')\n  for i=0,3 do mission.recover('guard-'..i) end\n  for i=0,2 do mission.recover('archer-'..i) end\n  mission.say('Marshal','unit.ants.marshal','The living resin restores our strength. Tend the wounded while we can. Something has nested around its source. Take the northern passage. No one goes alone.',10,true, 'marshal')\n elseif stage=='heart' and not mission.alive('heart-keeper.0') and not mission.alive('heart-keeper.1') and not mission.alive('heart-keeper.2') then\n  mission.complete_objective('heart');mission.set('stage','victory')\n  mission.say('Marshal','unit.ants.marshal','The Keeper is fallen. This is more than a mine, more than another resource to claim. The whole forest drinks from these roots. We must tell the colony.',11,true, 'marshal')\n elseif stage=='victory' then mission.win() end\n if not mission.get('cache') and mission.in_region('marshal','fungal-cache') then mission.set('cache','seen');mission.begin_objective('fungal-cache') end\n if mission.get('cache')=='seen' and not mission.alive('fungal-cache.0') and not mission.alive('fungal-cache.1') then mission.set('cache','done');mission.complete_objective('fungal-cache') end\nend\n",
    "regions": [
