{
  "v": 2,
  "size": 256,
  "name": "Lantern Hearth",
  "description": "Raise a colony in a sheltered clearing. Gather amber and lumber, train your first archers, and secure the road beyond the pond.",
  "mission": {
    "campaign": "vanguard",
    "title": "Mission 2 — Lantern Hearth",
    "order": 2,
    "objectives": [
      {
        "id": "gather",
        "title": "Stock the Mound",
        "description": "Gather 100 Amber and 60 Lumber. Select workers and right-click the mine or trees; cargo is delivered to the Mound.",
        "optional": false
      },
      {
        "id": "settle",
        "title": "Make room for a colony",
        "description": "Build a Worker House and a Barracks in the clearing.",
        "optional": false
      },
      {
        "id": "archers",
        "title": "Train two Archers",
        "description": "Recruit two Archers at the Barracks. Keep free workers available to enter the building.",
        "optional": false
      },
      {
        "id": "defend",
        "title": "Defend Lantern Hearth",
        "description": "Destroy the three raiders. The Marshal and Mound must survive.",
        "optional": false
      },
      {
        "id": "outpost",
        "title": "Secure the old gate",
        "description": "Follow the lantern road around the pond and defeat the ogre and its two wolves.",
        "optional": false
      },
      {
        "id": "cache",
        "title": "Explore the supply hollow",
        "description": "Clear the side path for a guaranteed Trailkeeper’s Flask.",
        "optional": true
      }
    ],
    "heroLevelCap": 4,
    "script": "function on_start()\n mission.set(\"stage\", \"gather\")\n mission.begin_objective(\"gather\")\n mission.say(\"Marshal\", \"unit.ants.marshal\", \"The watch is safe, but a patrol cannot hold this road forever. This clearing will be our home. Send workers to amber and trees. Each trip brings ten to the Mound. Keep me alive, and protect our Mound.\", 13, true)\nend\nfunction on_tick()\n if not mission.alive(\"marshal\") or not mission.alive(\"mound\") then mission.objective(\"The colony has lost its Marshal or Mound.\"); mission.lose(); return end\n local stage=mission.get(\"stage\")\n -- Players may build early; completed infrastructure is accepted as proof of gathering.\n if stage==\"gather\" and ((mission.stock(\"player.1\",\"item.amber\")>=100 and mission.stock(\"player.1\",\"item.wood\")>=60) or (mission.count(\"player.1\",\"building.ants.barracks\")>=1 and mission.count(\"player.1\",\"building.ants.house\")>=1)) then\n  mission.complete_objective(\"gather\");mission.begin_objective(\"settle\");mission.set(\"stage\",\"settle\")\n  mission.say(\"Vanguard scout\",\"unit.ants.archer\",\"A Worker House gives us more free ants. A Barracks gives them a new purpose. Workers busy gathering stay at their jobs unless you release them.\",10,true)\n elseif stage==\"settle\" and mission.count(\"player.1\",\"building.ants.barracks\")>=1 and mission.count(\"player.1\",\"building.ants.house\")>=1 then\n  mission.complete_objective(\"settle\");mission.begin_objective(\"archers\");mission.set(\"stage\",\"archers\")\n  mission.say(\"Marshal\",\"unit.ants.marshal\",\"Train two archers at the Barracks. Each needs amber, lumber, and a free worker who walks inside. Put our warriors in front when the fighting starts.\",10,true)\n elseif stage==\"archers\" and mission.count(\"player.1\",\"unit.ants.archer\")>=2 then\n  mission.complete_objective(\"archers\");mission.begin_objective(\"defend\");mission.set(\"stage\",\"raid\")\n  mission.spawn(\"raider-one\");mission.spawn(\"raider-two\");mission.spawn(\"raider-three\")\n  mission.attack_move(\"raider-one\",70,188);mission.attack_move(\"raider-two\",70,188);mission.attack_move(\"raider-three\",70,188)\n  mission.say(\"Vanguard scout\",\"unit.ants.archer\",\"Wolves on the eastern road! Our archers are ready. Keep them behind the line!\",7,true)\n elseif stage==\"raid\" and not mission.alive(\"raider-one\") and not mission.alive(\"raider-two\") and not mission.alive(\"raider-three\") then\n  mission.complete_objective(\"defend\");mission.begin_objective(\"outpost\");mission.set(\"stage\",\"outpost\")\n  mission.say(\"Marshal\",\"unit.ants.marshal\",\"We held. Follow the lanterns beyond the pond and clear the old gate. Leave enough workers here to keep the colony growing.\",9)\n elseif stage==\"outpost\" and not mission.alive(\"gate-ogre\") and not mission.alive(\"gate-wolf-one\") and not mission.alive(\"gate-wolf-two\") then\n  mission.complete_objective(\"outpost\");mission.set(\"stage\",\"victory\")\n  mission.say(\"Marshal\",\"unit.ants.marshal\",\"A roof, a watch, and a road we can defend. Now we are a colony. Beyond this gate, the old roots are turning bitter. We find out why at first light.\",11,true)\n elseif stage==\"victory\" then mission.win() end\n if not mission.get(\"cache_seen\") and mission.in_region(\"marshal\",\"cache\") then mission.set(\"cache_seen\",true);mission.begin_objective(\"cache\");mission.say(\"Marshal\",\"unit.ants.marshal\",\"An old supply hollow. Clear the beasts if you want what they have left behind.\",6) end\n if mission.get(\"cache_seen\") and not mission.get(\"cache_done\") and not mission.alive(\"cache-wolf-one\") and not mission.alive(\"cache-wolf-two\") then mission.set(\"cache_done\",true);mission.complete_objective(\"cache\") end\nend\n",
    "regions": [
      {
        "id": "cache",
        "x": 96,
        "y": 118,
        "radius": 15
      }
    ]
  },
