{
  "v": 2,
  "size": 512,
  "name": "The Amber Watch",
  "biome": "vibrant-forest",
  "mission": {
    "campaign": "vanguard",
    "title": "The Amber Watch",
    "order": 1,
    "objectives": [
      {
        "id": "lantern-road",
        "title": "Reach the Amber Watch",
        "description": "Follow the lantern road across Lantern Brook. Marshal Rowan must survive.",
        "optional": false
      },
      {
        "id": "rally-watch",
        "title": "Rally the scattered guard",
        "description": "Recruit the survivors at the ruined post and beyond the brook.",
        "optional": true
      },
      {
        "id": "break-siege",
        "title": "Break the siege",
        "description": "Defeat all siege attackers and their approaching relief column.",
        "optional": false
      }
    ],
    "presentation": {
      "loadingBackground": "asset.interface.campaign.amber-watch-loading",
      "selectionBackground": "asset.interface.campaign.amber-watch-selection",
      "chapter": "Chapter One",
      "briefing": "The watchfires have gone silent.\nLead Rowan along the lantern road, rally the scattered guard, and break the siege.",
      "tips": [
        "Attack-move along the road to keep the company together.",
        "Explore the hollows for supplies before taking on the siege.",
        "The bridge wardens can heal your surviving company."
      ],
      "features": [
        "One hero",
        "Allies along the road",
        "Break the siege"
      ]
    },
    "heroLevelCap": 3,
    "script": "-- All narrative state uses mission.get/set so cinematics and reinforcements survive saves.\nfunction siege_remaining()\n  local n=0\n  local ids={'siege-captain','siege-raider-1','siege-raider-2','siege-raider-3','siege-raider-4','siege-poacher-1','siege-poacher-2','siege-mortar-1','siege-mortar-2','relief-raider-1','relief-raider-2','relief-poacher'} for i=1,#ids do local id=ids[i]\n    if mission.alive(id) then n=n+1 end\n  end\n  return n\nend\nfunction mend_company()\n  local ids={'rowan','vanguard-1','vanguard-2','bow-1','post-warrior','post-archer','post-warrior-2','bridge-hunter','bridge-archer'} for i=1,#ids do local id=ids[i]\n    if mission.alive(id) then mission.recover(id) end\n  end\nend\nfunction spawn_siege()\n  local ids={'siege-captain','siege-raider-1','siege-raider-2','siege-raider-3','siege-raider-4','siege-poacher-1','siege-poacher-2','siege-mortar-1','siege-mortar-2'} for i=1,#ids do local id=ids[i] mission.spawn(id) end\n  mission.attack('siege-mortar-1','amber-watch')\n  mission.attack('siege-mortar-2','watch-tower-west')\nend\nfunction on_start()\n  mission.set('phase','opening')\n  mission.begin_objective('lantern-road')\n  mission.begin_objective('rally-watch')\n  mission.objective('Follow the lantern road to the Amber Watch. Rowan must survive.')\n  mission.camera('third-person','rowan','vanguard-1',10,3.2,55,1)\n  mission.say('Marshal Rowan','unit.ants.marshal','No watchfire. No messenger. The Amber Watch has never missed a signal. We take the old road. Keep your blades close.',6,true,'rowan')\nend\nfunction on_tick()\n  if not mission.alive('rowan') then mission.end_scene() mission.objective('Marshal Rowan has fallen.') mission.lose() return end\n  if mission.dialogue_busy() then return end\n  local phase=mission.get('phase')\n  if phase=='opening' then\n    mission.camera('rts','bow-1','rowan',14,8,55,.7)\n    mission.set('phase','opening-reply')\n    mission.say('Watch Archer','unit.ants.archer','Something moved in the mushrooms. We can follow the road, or clear the hollows for supplies. Your command, Marshal.',5,true,'bow-1')\n  elseif phase=='opening-reply' then\n    mission.end_scene() mission.set('phase','road')\n  elseif phase=='post-reply' then\n    mission.camera('third-person','rowan','post-archer',9,3,55,.6)\n    mission.say('Marshal Rowan','unit.ants.marshal','Then we march together. The Watch will not stand alone.',4,true,'rowan')\n    mission.set('phase','post-end')\n  elseif phase=='post-end' or phase=='crossing-end' then\n    mission.end_scene() mission.set('phase','road')\n  elseif phase=='road' then\n    if not mission.get('road-recruits') and mission.in_region('rowan','road-post') then\n      local ids={'post-warrior','post-archer','post-warrior-2'} for i=1,#ids do local id=ids[i] mission.transfer(id,'player.1') end\n      mission.set('road-recruits',true)\n      mission.camera('third-person','post-archer','rowan',9,2.8,55,.7)\n      mission.say('Watch Scout','unit.ants.archer','Rowan! Briar raiders burned the signal post. We held the road, but the others fell back across Lantern Brook. Let us join you.',6,true,'post-archer')\n      mission.set('phase','post-reply') return\n    end\n    if not mission.get('bridge-recruits') and mission.in_region('rowan','bridge-watch') then\n      mission.transfer('bridge-hunter','player.1') mission.transfer('bridge-archer','player.1')\n      mission.set('bridge-recruits',true) mend_company()\n      mission.camera('third-person','bridge-hunter','rowan',10,3,55,.7)\n      mission.say('Bridge Warden','unit.ants.hunter','The brook is behind us. Our last salves are yours. Listen... those are mortar shells. The Watch is still fighting!',6,true,'bridge-hunter')\n      mission.set('phase','crossing-end') return\n    end\n    if mission.get('road-recruits') and mission.get('bridge-recruits') and not mission.get('rallied') then mission.complete_objective('rally-watch') mission.set('rallied',true) end\n    if not mission.get('spring') and mission.in_region('rowan','spring') then\n      mend_company() mission.give_item('rowan','item.resin-salve') mission.set('spring',true)\n      mission.say('Marshal Rowan','unit.ants.marshal','Clear water, and a cache of resin. Take what we need. There is still time to reach the Watch.',4,false,'rowan')\n      return\n    end\n    if mission.in_region('rowan','siege-overlook') then\n      mission.complete_objective('lantern-road') mission.begin_objective('break-siege')\n      spawn_siege()\n      mission.camera('rts','fort-sentinel','rowan',24,13,55,1)\n      mission.set('phase','siege-call')\n      mission.say('Watch Sentinel','unit.ants.archer','The fort is under siege! Their mortars are breaking our towers. We cannot hold the gate alone!',6,true,'fort-sentinel') return\n    end\n  elseif phase=='siege-call' then\n    mission.camera('third-person','rowan','fort-sentinel',10,3.5,55,.8)\n    mission.say('Marshal Rowan','unit.ants.marshal','Those are our people. We are going to help them. Shields to the gate! Bows, cover the advance. Silence those mortars!',6,true,'rowan')\n    mission.set('phase','siege-reply')\n  elseif phase=='siege-reply' then\n    mission.end_scene()\n    local ids={'fort-sentinel','fort-guard-1','fort-guard-2'} for i=1,#ids do local id=ids[i] mission.transfer(id,'player.1') mission.attack_move(id,405,155) end\n    local ids={'siege-captain','siege-raider-1','siege-raider-2','siege-raider-3','siege-raider-4','siege-poacher-1','siege-poacher-2'} for i=1,#ids do local id=ids[i] mission.attack_move(id,405,140) end\n    mission.set('phase','siege') mission.set('siege-start',mission.tick()) mission.set('last-remaining',-1)\n    mission.objective('Break the siege. Defeat every attacker; a relief column is approaching. Rowan must survive.')\n  elseif phase=='siege' then\n    -- Reinforcements arrive by elapsed gameplay time, never during a paused cinematic.\n    if not mission.get('relief') and mission.tick()-mission.get('siege-start')>=1000 then\n      local ids={'relief-raider-1','relief-raider-2','relief-poacher'} for i=1,#ids do local id=ids[i] mission.spawn(id) mission.attack_move(id,405,155) end\n      mission.set('relief',true)\n      mission.say('Marshal Rowan','unit.ants.marshal','Another column from the briars! Hold together. This is their last push!',4,false,'rowan')\n    end\n    local n=siege_remaining()\n    if n~=mission.get('last-remaining') then\n      mission.set('last-remaining',n)\n      mission.objective('Defeat every siege attacker. Remaining: '..n..(mission.get('relief') and '' or ' + approaching relief column')..'. Rowan must survive.')\n    end\n    if n==0 and mission.get('relief') then\n      mission.complete_objective('break-siege') mission.set('phase','victory-speech')\n      mission.camera('rts','rowan',nil,23,12,55,1)\n      mission.say('Marshal Rowan','unit.ants.marshal','Raise the watchfire. Let the whole canopy see it. The Amber Watch stands, and tonight no ant stands alone.',7,true,'rowan')\n    end\n  elseif phase=='victory-speech' then mission.end_scene() mission.win() end\nend\n",
