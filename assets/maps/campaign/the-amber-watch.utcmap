{
  "v": 2,
  "size": 256,
  "name": "The Amber Watch",
  "biome": "vibrant-forest",
  "description": "Chapter I \u2014 The Amber Watch. Lead Marshal Rowan and a small patrol along the lantern road. Rally the scattered watch, cross the Lantern Brook, and relieve a neutral ant outpost besieged by Briar raiders. Defeat every siege attacker to win. Rowan must survive. No base building is required.",
  "mission": {
    "campaign": "vanguard",
    "title": "The Amber Watch",
    "order": 1,
    "objectives": [
      {
        "id": "lantern-road",
        "title": "Follow the lantern road",
        "description": "Lead Rowan across the Lantern Brook and find the isolated Amber Watch. Rowan must survive.",
        "optional": false
      },
      {
        "id": "rally-watch",
        "title": "Rally the scattered watch",
        "description": "Find the two soldiers at the ruined road post and the two wardens beyond the bridge.",
        "optional": true
      },
      {
        "id": "break-siege",
        "title": "Break the siege of the Amber Watch",
        "description": "Help the neutral ant garrison. Defeat all nine siege attackers, including both mortar crews.",
        "optional": false
      }
    ],
    "heroLevelCap": 2,
    "script": "function siege_remaining()\n  local n = 0\n  if mission.alive('siege-captain') then n = n + 1 end\n  if mission.alive('siege-raider-1') then n = n + 1 end\n  if mission.alive('siege-raider-2') then n = n + 1 end\n  if mission.alive('siege-raider-3') then n = n + 1 end\n  if mission.alive('siege-raider-4') then n = n + 1 end\n  if mission.alive('siege-poacher-1') then n = n + 1 end\n  if mission.alive('siege-poacher-2') then n = n + 1 end\n  if mission.alive('siege-mortar-1') then n = n + 1 end\n  if mission.alive('siege-mortar-2') then n = n + 1 end\n  return n\nend\nfunction on_start()\n  mission.set('phase', 'opening')\n  mission.begin_objective('lantern-road')\n  mission.begin_objective('rally-watch')\n  mission.objective('Follow the lantern road. Marshal Rowan must survive.')\n  mission.say('Marshal Rowan', 'unit.ants.marshal', 'The Amber Watch has gone silent. We take the old lantern road. Keep close, and watch the thickets.', 7, true, 'rowan')\nend\nfunction on_tick()\n  local phase = mission.get('phase')\n  if not mission.alive('rowan') then\n    mission.objective('Marshal Rowan has fallen.')\n    mission.lose()\n    return\n  end\n  if phase == 'opening' then\n    mission.set('phase', 'road')\n    mission.say('Marshal Rowan', 'unit.ants.marshal', 'Move as a company. Attack-move along the trail to meet any creatures hiding beside it. The pool and spider hollow are optional detours.', 9, false, 'rowan')\n    return\n  end\n  if phase == 'road' and not mission.dialogue_busy() then\n    if not mission.get('road-recruits') and mission.in_region('rowan', 'road-post') then\n      mission.transfer('post-warrior', 'player.1')\n      mission.transfer('post-archer', 'player.1')\n      mission.set('road-recruits', true)\n      mission.say('Watch Scout', 'unit.ants.archer', 'Marshal! Briar raiders cut us off from the outpost. We held this old post. Our blades and bows are yours.', 7, true, 'post-archer')\n      return\n    end\n    if not mission.get('bridge-recruits') and mission.in_region('rowan', 'bridge-watch') then\n      mission.transfer('bridge-hunter', 'player.1')\n      mission.transfer('bridge-archer', 'player.1')\n      mission.set('bridge-recruits', true)\n      mission.recover('rowan')\n      mission.recover('vanguard-1')\n      mission.recover('vanguard-2')\n      mission.recover('bow-1')\n      mission.recover('post-warrior')\n      mission.recover('post-archer')\n      mission.say('Bridge Warden', 'unit.ants.hunter', 'We kept the crossing open. Take a breath; our salves will mend the surviving patrol. Then we march with you to the Watch.', 7, true, 'bridge-hunter')\n      return\n    end\n    if mission.get('road-recruits') and mission.get('bridge-recruits') and not mission.get('rallied') then\n      mission.complete_objective('rally-watch')\n      mission.set('rallied', true)\n    end\n    if mission.in_region('rowan', 'siege-overlook') then\n      mission.complete_objective('lantern-road')\n      mission.begin_objective('break-siege')\n      mission.spawn('siege-captain')\n      mission.spawn('siege-raider-1')\n      mission.spawn('siege-raider-2')\n      mission.spawn('siege-raider-3')\n      mission.spawn('siege-raider-4')\n      mission.spawn('siege-poacher-1')\n      mission.spawn('siege-poacher-2')\n      mission.spawn('siege-mortar-1')\n      mission.spawn('siege-mortar-2')\n      mission.attack('siege-mortar-1', 'amber-watch')\n      mission.attack('siege-mortar-2', 'amber-watch')\n      mission.attack_move('siege-captain', 213, 72)\n      mission.attack_move('siege-raider-1', 205, 64)\n      mission.attack_move('siege-raider-2', 210, 65)\n      mission.attack_move('siege-raider-3', 219, 66)\n      mission.attack_move('siege-raider-4', 223, 63)\n      mission.attack_move('siege-poacher-1', 203, 70)\n      mission.attack_move('siege-poacher-2', 224, 70)\n      mission.begin_scene(212, 65)\n      mission.set('phase', 'siege-call')\n      mission.say('Watch Sentinel', 'unit.ants.archer', 'The fort is under siege! Their mortars are tearing into the Acorn Hall. We cannot hold them alone!', 7, true, 'fort-sentinel')\n      return\n    end\n  elseif phase == 'siege-call' then\n    mission.set('phase', 'siege-reply')\n    mission.say('Marshal Rowan', 'unit.ants.marshal', 'Those are our people. We are going to help them. Warriors, break their line! Archers, cover us. Silence those mortars!', 8, true, 'rowan')\n    return\n  elseif phase == 'siege-reply' then\n    mission.end_scene()\n    mission.transfer('fort-sentinel', 'player.1')\n    mission.transfer('fort-guard-1', 'player.1')\n    mission.transfer('fort-guard-2', 'player.1')\n    mission.attack_move('fort-sentinel', 213, 76)\n    mission.attack_move('fort-guard-1', 207, 77)\n    mission.attack_move('fort-guard-2', 219, 77)\n    mission.set('phase', 'siege')\n    mission.set('last-remaining', -1)\n    return\n  elseif phase == 'siege' then\n    local n = siege_remaining()\n    if n ~= mission.get('last-remaining') then\n      mission.set('last-remaining', n)\n      mission.objective('Defeat every siege attacker. Remaining: ' .. n .. '. Marshal Rowan must survive.')\n    end\n    if n == 0 then\n      mission.complete_objective('break-siege')\n      mission.set('phase', 'victory-speech')\n      mission.say('Marshal Rowan', 'unit.ants.marshal', 'The lanterns still burn. The Watch is safe, and the road is ours again. Tend the wounded. Tonight, no ant stands alone.', 8, true, 'rowan')\n      return\n    end\n  elseif phase == 'victory-speech' then\n    mission.win()\n  end\nend\n",
    "regions": [
