{
  "v": 2,
  "size": 256,
  "name": "The Hollow Gate",
  "description": "An amber-lit doorway in a fallen giant. Cross the river by lantern bridge, take the root overlook, and lead the Vanguard into the heartwood.",
  "mission": {
    "campaign": "vanguard",
    "company": [
      "marshal",
      "guard-0",
      "guard-1",
      "guard-2",
      "guard-3",
      "archer-0",
      "archer-1",
      "archer-2"
    ],
    "nextMission": "vanguard-heartwood-vault",
    "order": 4,
    "title": "Mission 4 — The Hollow Gate",
    "heroLevelCap": 7,
    "objectives": [
      {
        "id": "crossing",
        "title": "Cross the shaded river",
        "description": "Follow the lantern road to the old stone bridge."
      },
      {
        "id": "gate",
        "title": "Break the gate watch",
        "description": "Defeat the three creatures guarding the hollow entrance."
      },
      {
        "id": "enter",
        "title": "Enter the heartwood",
        "description": "Bring the Marshal through the amber-lit opening."
      },
      {
        "id": "moss-cache",
        "title": "Explore the moss hollow",
        "description": "Take the northern timber bridge and defeat the two guardians for a Trailkeeper’s Flask.",
        "optional": true
      },
      {
        "id": "bitter-cache",
        "title": "Search the bitter grove",
        "description": "Clear the southern Root grove for a Thornband.",
        "optional": true
      }
    ],
    "regions": [
      {
        "id": "crossing",
        "x": 153,
        "y": 163,
        "radius": 7
      },
      {
        "id": "gate",
        "x": 188,
        "y": 119,
        "radius": 15
      },
      {
        "id": "entrance",
        "x": 188,
        "y": 104,
        "radius": 5
      },
      {
        "id": "moss-cache",
        "x": 75,
        "y": 75,
        "radius": 16
      },
      {
        "id": "bitter-cache",
        "x": 123,
        "y": 227,
        "radius": 15
      }
    ],
    "script": "function on_start()\n mission.set('stage','crossing');mission.begin_objective('crossing')\n mission.say('Marshal','unit.ants.marshal','The Root runs beneath that fallen giant. The old lantern road will take us to its hollow. Stay together at the river; the forest has eyes on both banks.',11,true)\nend\nfunction on_tick()\n if not mission.alive('marshal') then mission.lose();return end\n local stage=mission.get('stage')\n if stage=='crossing' and mission.in_region('marshal','crossing') then\n  mission.complete_objective('crossing');mission.begin_objective('gate');mission.set('stage','gate')\n  mission.say('Vanguard scout','unit.ants.archer','A watch at the entrance. There is a root arch to the west: its crown gives our archers a firing position, and the lower trail passes beneath it.',10,true)\n elseif stage=='gate' and not mission.alive('gate-wardens.0') and not mission.alive('gate-wardens.1') and not mission.alive('gate-wardens.2') then\n  mission.complete_objective('gate');mission.begin_objective('enter');mission.set('stage','enter')\n  mission.say('Marshal','unit.ants.marshal','The entrance is clear. Gather the wounded. Beyond that amber light, we leave the canopy behind and enter the tree itself.',9,true)\n elseif stage=='enter' and mission.in_region('marshal','entrance') then\n  mission.complete_objective('enter');mission.set('stage','victory')\n  mission.say('Marshal','unit.ants.marshal','Listen. Something moves inside the heartwood. Shields forward. We go in together.',7,true)\n elseif stage=='victory' then mission.win() end\n local caches={'moss-cache','bitter-cache'}\n for i=1,2 do\n  local name=caches[i]\n  if not mission.get(name) and mission.in_region('marshal',name) then mission.set(name,'seen');mission.begin_objective(name) end\n  if mission.get(name)=='seen' and not mission.alive(name..'.0') and not mission.alive(name..'.1') then mission.set(name,'done');mission.complete_objective(name) end\n end\nend\n"
  },
