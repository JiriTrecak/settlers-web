{
  "v": 2,
  "size": 256,
  "name": "The Defense of Briarwatch",
  "description": "A Marshal, four guards, and a forest village in danger. Follow the old road, rally the villagers, uncover optional rescues and stolen supplies, then break the raiders holding Briarwatch.",
  "mission": {
    "campaign": "vanguard",
    "title": "Reference — The Defense of Briarwatch",
    "order": 6,
    "heroLevelCap": 2,
    "objectives": [
      {
        "id": "defend",
        "title": "Defend Briarwatch",
        "description": "Reach Briarwatch and defeat the raiders. The Marshal must survive.",
        "optional": false
      },
      {
        "id": "captain",
        "title": "Break the raider command",
        "description": "Defeat the Briar Captain and his escorts in the northern square.",
        "optional": false
      },
      {
        "id": "rescue",
        "title": "The missing youngling",
        "description": "Defeat the scavengers, break the twig cage, and bring the youngling back to the caretaker.",
        "optional": true
      },
      {
        "id": "ledger",
        "title": "The stolen ledger",
        "description": "Defeat the thieves, pick up the Merchant’s Leaf Ledger, and return it to Pell at his cart.",
        "optional": true
      }
    ],
    "regions": [
