{
  "v": 2,
  "size": 256,
  "name": "The Bitter Root",
  "description": "Lead an expedition around the flooded hollow. Hold a corrupted vein, establish a Rootworks, and turn the colony into a Great Mound.",
  "mission": {
    "campaign": "vanguard",
    "title": "Mission 3 — The Bitter Root",
    "order": 3,
    "objectives": [
      {
        "id": "find-root",
        "title": "Find the corrupted vein",
        "description": "Follow the lantern road around the pond. Keep the Marshal and Mound alive.",
        "optional": false
      },
      {
        "id": "guardians",
        "title": "Clear the Root guardians",
        "description": "Defeat the ogre and two wolves at the vein.",
        "optional": false
      },
      {
        "id": "rootworks",
        "title": "Establish a Rootworks",
        "description": "Build a Rootworks beside the vein, leaving space for workers to approach.",
        "optional": false
      },
      {
        "id": "harvest-root",
        "title": "Bring home 100 Root",
        "description": "Assign workers to the corrupted root. Up to five gather at once; each delivers ten to the Rootworks.",
        "optional": false
      },
      {
        "id": "great-mound",
        "title": "Raise the Great Mound",
        "description": "Upgrade your original Mound using Amber, Lumber and Root.",
        "optional": false
      },
      {
        "id": "hunters",
        "title": "Train two Hunters",
        "description": "Recruit two Hunters at the Barracks and bring the Marshal back to the vein.",
        "optional": false
      },
      {
        "id": "hold-root",
        "title": "Hold the Root clearing",
        "description": "Defeat the incoming ogre and three wolves.",
        "optional": false
      },
      {
        "id": "cache",
        "title": "Explore the old shell",
        "description": "Defeat the lone ogre on the western detour for a guaranteed Thornband.",
        "optional": true
      }
    ],
    "heroLevelCap": 6,
    "script": "function on_start()\n mission.set(\"stage\",\"scout\");mission.begin_objective(\"find-root\")\n mission.say(\"Marshal\",\"unit.ants.marshal\",\"Amber keeps us alive. The bitter Root could make us stronger. Take the southern bank around the pond. Find the vein, clear its guardians, and protect the workers who follow us.\",12,true)\nend\nfunction on_tick()\n if not mission.alive(\"marshal\") or not mission.alive(\"mound\") then mission.objective(\"The expedition has lost its Marshal or Mound.\");mission.lose();return end\n local stage=mission.get(\"stage\")\n if stage==\"scout\" and mission.in_region(\"marshal\",\"root-vein\") then\n  mission.complete_objective(\"find-root\");mission.begin_objective(\"guardians\");mission.set(\"stage\",\"guardians\")\n  mission.say(\"Vanguard scout\",\"unit.ants.archer\",\"There it is. The beasts have made their den among the roots. Clear them before we bring the workers forward.\",8,true)\n elseif stage==\"guardians\" and not mission.alive(\"root-ogre\") and not mission.alive(\"root-wolf-one\") and not mission.alive(\"root-wolf-two\") then\n  mission.complete_objective(\"guardians\");mission.begin_objective(\"rootworks\");mission.set(\"stage\",\"rootworks\")\n  mission.say(\"Marshal\",\"unit.ants.marshal\",\"Build a Rootworks here, beside the vein. Workers carry ten Root each trip, but only five can gather at once. They bring it only to a Rootworks — the Mound cannot process it.\",12,true)\n elseif stage==\"rootworks\" and mission.count(\"player.1\",\"building.ants.rootworks\")>=1 then\n  mission.complete_objective(\"rootworks\");mission.begin_objective(\"harvest-root\");mission.set(\"stage\",\"harvest\")\n  mission.say(\"Marshal\",\"unit.ants.marshal\",\"Assign workers directly to the corrupted root. Hold this clearing while they work. We need one hundred Root for the Great Mound.\",9)\n elseif stage==\"harvest\" and (mission.stock(\"player.1\",\"item.root\")>=100 or mission.count(\"player.1\",\"building.ants.great-mound\")>=1) then\n  mission.complete_objective(\"harvest-root\");mission.begin_objective(\"great-mound\");mission.set(\"stage\",\"upgrade\")\n  mission.say(\"Marshal\",\"unit.ants.marshal\",\"The first loads are secured. Upgrade our Mound to a Great Mound. That will let the Barracks train Hunters — spearmen who charge to close the distance.\",10,true)\n elseif stage==\"upgrade\" and mission.count(\"player.1\",\"building.ants.great-mound\")>=1 then\n  mission.complete_objective(\"great-mound\");mission.begin_objective(\"hunters\");mission.set(\"stage\",\"hunters\")\n  mission.say(\"Marshal\",\"unit.ants.marshal\",\"Train two Hunters. Their spears cost amber and lumber; Root opened the path to them. Bring them to the vein. Another pack is coming.\",10,true)\n elseif stage==\"hunters\" and mission.count(\"player.1\",\"unit.ants.hunter\")>=2 and mission.in_region(\"marshal\",\"root-vein\") then\n  mission.complete_objective(\"hunters\");mission.begin_objective(\"hold-root\");mission.set(\"stage\",\"defend\")\n  local raiders={\"counter-ogre\",\"counter-wolf-one\",\"counter-wolf-two\",\"counter-wolf-three\"}\n  for i=1,4 do mission.spawn(raiders[i]);mission.attack_move(raiders[i],213,84) end\n  mission.say(\"Vanguard scout\",\"unit.ants.archer\",\"Movement beyond the roots! Protect the workers. Hunters, take the flank!\",7,true)\n elseif stage==\"defend\" and not mission.alive(\"counter-ogre\") and not mission.alive(\"counter-wolf-one\") and not mission.alive(\"counter-wolf-two\") and not mission.alive(\"counter-wolf-three\") then\n  mission.complete_objective(\"hold-root\");mission.set(\"stage\",\"victory\")\n  mission.say(\"Marshal\",\"unit.ants.marshal\",\"The Root is ours to study, and ours to defend. We came beneath these trees with three soldiers. Now the forest knows a colony stands here.\",10,true)\n elseif stage==\"victory\" then mission.win() end\n if not mission.get(\"cache_seen\") and mission.in_region(\"marshal\",\"cache\") then mission.set(\"cache_seen\",true);mission.begin_objective(\"cache\") end\n if mission.get(\"cache_seen\") and not mission.get(\"cache_done\") and not mission.alive(\"cache-ogre\") then mission.set(\"cache_done\",true);mission.complete_objective(\"cache\") end\nend\n",
    "regions": [
      {
        "id": "root-vein",
        "x": 213,
        "y": 84,
        "radius": 19
      },
      {
        "id": "cache",
        "x": 114,
        "y": 105,
        "radius": 15
      }
    ]
  },
