# Original Settlers III install — never commit. Delete the whole folder when dumps exist.
/original/

# Reconstructed pixels + generated catalog — never commit
assets/graphics/*
!assets/graphics/.gitkeep

# Original .map copies + generated catalog — never commit
assets/maps/*
!assets/maps/.gitkeep

# Authored reference landscapes are source assets.
!assets/maps/showcase/
!assets/maps/showcase/*.utcmap

# Authored playable maps are source assets too.
!assets/maps/skirmish/
!assets/maps/skirmish/*.utcmap

# Reproducible wiki output
/wiki/.generated/
/wiki/.vitepress/cache/
/wiki/.vitepress/dist/

# Authored campaign missions include their Lua source.
!assets/maps/campaign/
!assets/maps/campaign/*.utcmap

# Local Asset Studio jobs, credentials and recovery journals
/.asset-work/

__pycache__/
*.pyc

# Disposable review evidence; keep source masters in art/, captures in tmp/.
/docs/proofs/
/artifacts/
/experiments/ai/

# Local Eve conversations, compiled runtimes and diagnostic data
/tooling/spell-editor/agent-app/.eve/
/tooling/spell-editor/agent-app/.output/
/tooling/spell-editor/agent-app/.nitro/

# Published strategic atlases are small runtime assets, not world-generation caches.
!assets/maps/previews/
!assets/maps/previews/*.webp
!assets/maps/previews/index.json

# Temporary shared release-log lock
/releases/log.json.lock
