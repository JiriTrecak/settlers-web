{
  "schemaVersion": 1,
  "id": "ability.core.flight-form",
  "name": "Flight Form",
  "description": "Toggle a flying wasp form at 7 world units above terrain. Uses our existing Needle Wasp model; identity, health, supply and body size remain unchanged. Toggle off to land nearby. If blocked, stay airborne until safe ground becomes available.",
  "activation": "targeted",
  "persistent": {
    "durationTicks": 144000,
    "intervalTicks": 40,
    "anchor": "caster",
    "endsWithCaster": true,
    "upkeepMana": 0,
    "toggle": true
  },
  "ranks": [
    {}
  ],
  "targeting": {
    "kind": "self",
    "alive": true,
    "visible": true,
    "relations": [
      "ally"
    ],
    "allowSelf": true,
    "range": 0,
    "outOfRange": "reject"
  },
  "cast": {
    "prepareTicks": 10,
    "recoverTicks": 8,
    "cost": {
      "resource": "mana",
      "amount": 25,
      "commit": "release"
    },
    "cooldown": {
      "ticks": 0,
      "start": "release",
      "scope": "ability"
    },
    "cancelBeforeRelease": "refund",
    "revalidateAtRelease": [
      "caster",
      "target",
      "range",
      "visibility",
      "relationship"
    ]
  },
  "onRelease": [
    {
      "op": "status",
      "target": "caster",
      "id": "soaring",
      "amount": 80,
      "polarity": "positive",
      "dispel": true,
      "modifiers": {},
      "form": {
        "movement": {
          "locomotion": "air",
          "flightHeight": 7
        },
        "opacity": 1,
        "asset": "asset.neutral.needle-wasp",
        "scale": 1
      },
      "lifetime": "instance"
    }
  ],
  "presentation": "presentation.core.flight-form"
}
