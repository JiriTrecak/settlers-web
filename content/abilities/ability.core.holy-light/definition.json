          "kind": "matches",
          "of": "target",
          "relations": [
            "ally"
          ],
          "filter": {
            "natures": [
              "organic"
            ]
          }
        },
        {
          "kind": "matches",
          "of": "target",
          "relations": [
            "enemy"
          ],
          "filter": {
            "natures": [
              "undead"
            ]
          }
        }
      ]
    },
