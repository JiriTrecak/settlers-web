{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forest Empire Tools",
  "version": "0.1.0",
  "identifier": "com.jiritrecak.forest-empire.tools",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev:tools",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm --prefix .. run build:tools",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forest Empire Tools",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico",
      "../../src-tauri/icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
