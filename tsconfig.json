{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {"@/*": ["./src/*"]},
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client",
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "tests",
    "server",
    "tooling",
    "mcp",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tooling/dist",
    "tooling/src-tauri"
  ]
}
