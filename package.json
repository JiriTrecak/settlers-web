{
  "name": "settlers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tools": "vite --config tooling/vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:tools": "vite build --config tooling/vite.config.ts",
    "tauri:tools": "vite-node tooling/tauri.mjs dev",
    "pack:tools": "vite-node tooling/tauri.mjs build",
    "tauri": "tauri",
    "preview": "vite preview",
    "test": "vitest run",
    "mcp:editor": "tsx mcp/editor/index.ts",
    "server": "tsx server/index.ts",
    "server:deploy": "bash scripts/deploy.sh",
    "building:studio": "node experiments/building-studio/launch.mjs",
    "wiki:generate": "node --import tsx scripts/wiki/generate.ts generate",
    "wiki:dev": "node --import tsx scripts/wiki/generate.ts dev",
    "wiki:build": "node --import tsx scripts/wiki/generate.ts build",
    "wiki:preview": "node --import tsx scripts/wiki/generate.ts preview",
    "wiki:check": "tsc --project scripts/wiki/tsconfig.json",
    "build:desktop": "tauri build --bundles app",
    "bench:sim": "node --import tsx scripts/bench/simulation.ts",
    "assets:compile": "node --import tsx scripts/assets/compile.ts",
    "assets:studio": "node --import tsx tooling/asset-studio/cli.ts",
    "assets:publish": "node --import tsx scripts/assets/publish-authoring.ts",
    "docs:check": "node --import tsx scripts/docs/check.ts",
    "bench:authoring": "node --import tsx scripts/bench/authoring.ts",
    "dev:spells": "vite --config tooling/spell-editor/vite.config.ts",
    "build:spells": "vite build --config tooling/spell-editor/vite.config.ts",
    "mcp:spells": "tsx mcp/spells/index.ts",
    "maps:previews": "node --import tsx scripts/maps/previews.ts",
    "maps:check": "node --import tsx scripts/maps/previews.ts --check",
    "prebuild": "npm run maps:previews",
    "bench:scenery-rays": "vite-node --config vitest.config.ts scripts/bench/scenery-rays.ts",
    "bench:textures": "vite --config scripts/bench/texture-sharing/vite.config.ts --open /scripts/bench/texture-sharing/index.html",
    "bench:scenery-cells": "vite --config scripts/bench/scenery-cells/vite.config.ts --open /scripts/bench/scenery-cells/index.html",
    "bench:scenery-visibility": "node --import tsx scripts/bench/scenery-visibility.ts",
    "bench:worker-decode": "vite --config scripts/bench/worker-decode/vite.config.ts --open /scripts/bench/worker-decode/index.html"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@mastra/core": "^1.64.0",
    "@mastra/mcp": "^1.17.3",
    "@napi-rs/keyring": "^2.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eve": "^0.70.0",
    "fengari": "0.1.5",
    "lucide": "^1.41.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "react-resizable-panels": "^4.14.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.185.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "meshoptimizer": "^1.1.1",
    "node": "^24.21.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.10"
  }
}
