{
  "name": "settlers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tools": "vite --config tooling/vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:tools": "vite build --config tooling/vite.config.ts",
    "tauri:tools": "vite-node tooling/tauri.mjs dev",
    "pack:tools": "vite-node tooling/tauri.mjs build",
    "tauri": "tauri",
    "preview": "vite preview",
    "test": "vitest run",
    "mcp:editor": "tsx mcp/editor/index.ts",
    "server": "tsx server/index.ts",
    "server:deploy": "bash scripts/deploy.sh",
    "building:studio": "node experiments/building-studio/launch.mjs",
    "wiki:generate": "node --import tsx scripts/wiki/generate.ts generate",
    "wiki:dev": "node --import tsx scripts/wiki/generate.ts dev",
    "wiki:build": "node --import tsx scripts/wiki/generate.ts build",
    "wiki:preview": "node --import tsx scripts/wiki/generate.ts preview",
    "wiki:check": "tsc --project scripts/wiki/tsconfig.json",
    "build:desktop": "tauri build --bundles app",
    "bench:sim": "node --import tsx scripts/bench/simulation.ts",
    "assets:compile": "node --import tsx scripts/assets/compile.ts",
    "assets:studio": "node --import tsx tooling/asset-studio/cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@mastra/core": "^1.64.0",
    "@mastra/mcp": "^1.17.3",
    "fengari": "0.1.5",
    "lucide": "^1.41.0",
    "three": "^0.185.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "meshoptimizer": "^1.1.1",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.10"
  }
}
