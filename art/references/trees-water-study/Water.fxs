//--------------------------------------------------------------------------------------
// Structures
struct VS_INPUT
{
	float4 vBlockData : BYTEDATA0;
};
struct VS_HS_OUTPUT
{
	float3 worldPos		: WORLDPOS;
};
struct DS_OUTPUT
{
	float4 worldPos_w : WORLDPOS_W;
	float occlusion : OCCLUSION;

	float3 directLight	: DIRECTLIGHT;
	float3 ambientLight : AMBIENTLIGHT;
	float4 fogColor : FOGCOLOR;
};

//--------------------------------------------------------------------------------------
// Functions
//--------------------------------------------------------------------------------------

float GetWaves(out float3 localNormal, out float3 worldNormal, out float foam,
	in float wavesMip, in float2 flowDir, in float flowSpeed, in float3 worldPos, in float3 baseNormal,
	uniform bool isPixelShader, uniform float extraScale = 1.75f)
{
	float2 dir1, dir2;
	float angT;
	float lin0, lin1, linT;
	DiscretizeWaves(flowDir, flowSpeed, dir1, dir2, angT, lin0, lin1, linT);

	// some V offset so octaves wont sync up
	float2 angTC1 = float2(
		dot(float2(+dir1.x, +dir1.y), worldPos.xz),
		dot(float2(-dir1.y, +dir1.x), worldPos.xz));
	float2 angTC2 = float2(
		dot(float2(+dir2.x, +dir2.y), worldPos.xz),
		dot(float2(-dir2.y, +dir2.x), worldPos.xz));	

	float2 tcScroll = float2(-5.f, 0) * g_fSceneTime + float2(0.f, 50.f);
	float tcScale = .1f / extraScale;

#ifdef SHOW_NORMALMAP
	// no scroll
	waves = lerp(
		sampleLevel2D(TX_WATER_WAVES, angTC1 * tcScale),
		sampleLevel2D(TX_WATER_WAVES, angTC2 * tcScale), angT);
	worldNormal.xy = waves.rg;
	worldNormal.z = 1.f;
	return 0;
#endif
	if (!isPixelShader) {
		wavesMip *= 2.f;
	}
	float4 waves0, waves1;
	waves0 = lerp(
		sampleLevel2D(TX_WATER_WAVES, (angTC1 + tcScroll * lin0) * tcScale, wavesMip),
		sampleLevel2D(TX_WATER_WAVES, (angTC2 + tcScroll * lin0) * tcScale, wavesMip), angT);
	waves1 = lerp(
		sampleLevel2D(TX_WATER_WAVES, (angTC1 + tcScroll * lin1) * tcScale, wavesMip),
		sampleLevel2D(TX_WATER_WAVES, (angTC2 + tcScroll * lin1) * tcScale, wavesMip), angT);
	float4 waves = lerp(waves0, waves1, linT);

	float flowAtten = flowSpeed;
	if (!isPixelShader) {
		flowAtten = pow(saturate((flowAtten - .02f) / .96f), .5f);
	}
	localNormal = UnpackXYNormal(waves.rg);	
	{
		float3x3 tangentSpace = GetTangentSpaceBasis(float3(flowDir.x, 0, flowDir.y), baseNormal, 1.f);
		worldNormal = mul(localNormal, tangentSpace);
	}
	float4 wavesDisturbance;	
	{
		wavesDisturbance = sampleLevel2D(TX_WATER_WAVES, worldPos.xz * tcScale * 1.f, wavesMip);
		wavesDisturbance.rg = float2(.50196f, .50196f);// lerp(float2(.50196f, .50196f), wavesDisturbance.rg, disturbance);
		
		float3 localNormalDisturbance = UnpackXYNormal(wavesDisturbance.rg);
		localNormal = normalize(lerp(localNormalDisturbance, localNormal, flowAtten));

		float3x3 tangentSpace = GetTangentSpaceBasis(float3(1,0,0), baseNormal, 1.f);
		worldNormal = normalize(lerp(mul(localNormalDisturbance, tangentSpace), worldNormal, flowAtten));

		waves.b = lerp(wavesDisturbance.b, waves.b, saturate(flowSpeed / .2f));
	}
	if (isPixelShader) {
		// color
		foam = waves.b;
		return lerp(0/*wavesDisturbance.a * disturbance*/, waves.a, flowAtten);
	} else {
		// height offset
		foam = saturate(lerp(wavesDisturbance.b, waves.b, flowAtten) * 1.6f - .4f) * .4f;
		return lerp(0/*(wavesDisturbance.a - .35f) * 2.f * max(disturbance, .25f)*/, (waves.a - .35f) * 4.f, flowAtten);
	}
}//
//--------------------------------------------------------------------------------------
void GetWaterFoamAndFlow(in float4 waterMap, in float4 waterSim, out float foamCoef, out float2 flow) {
	foamCoef = saturate(WATER_MAP_FOAM(waterMap) +
		WATER_SIM_DYNAMIC_FOAM(waterSim) * 1.f/* + 
		max(WATER_SIM_HEIGHTOFFSET(waterSim) - .50196f, 0.f) * 1.f*/);

	float2 staticFlow = UnpackNormal2(WATER_MAP_FLOW(waterMap));
	float2 disturbance = UnpackNormal2(WATER_SIM_DISTURBANCE(waterSim));
	disturbance *= .6f + length(staticFlow) * .4f; // less dynamic flow in static water
	flow = (staticFlow + disturbance) * (1.f - foamCoef * .6f); // less flow with foam
}//
//--------------------------------------------------------------------------------------
float GetWaterWavesMip(in float3 worldPos, in float3 baseNormal) {
	return log2(length(g_vEyePos - worldPos) / 64.f / max(dot(baseNormal, normalize(g_vEyePos - worldPos)), .01f));
}//
//--------------------------------------------------------------------------------------
//--------------------------------------------------------------------------------------
// Vertex shader
// Main
VS_HS_OUTPUT waterVS(const VS_INPUT v, uint vertexID : SV_VertexID)
{
	VS_HS_OUTPUT Out;
	float2 blockXZ;
	{
		// no world matrix, object space equals world space
		float2 quadXZ[4] = {
			float2(0, 0),
			float2(0, 1),
			float2(1, 1),
			float2(1, 0)
		};
		uint quadID = vertexID / 4; // 4 vertex per quad
		uint vertexInQuadID = vertexID - quadID * 4;

		uint quad_z = quadID / 4; // 4x4 quad per block
		uint quad_x = quadID - quad_z * 4;				
		blockXZ.x = quad_x / 4.f;
		blockXZ.y = quad_z / 4.f;
		blockXZ += quadXZ[vertexInQuadID] / 4.f;
	}

	float block_x = v.vBlockData.b * 255.f;
	float block_z = v.vBlockData.g * 255.f;

	float3 worldPos;
	worldPos.x = g_vTerrainPosData.x + block_x * TERRAIN_BLOCK_SIZE;
	worldPos.z = g_vTerrainPosData.y + block_z * TERRAIN_BLOCK_SIZE;
	worldPos.xz += blockXZ * TERRAIN_BLOCK_SIZE;

	float2 terrainTC = (worldPos.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw;
	worldPos.y = UnpackHeight(sampleLevel2D(TX_TCOMMON_WATERHEIGHTMAP, terrainTC).r);

	Out.worldPos = worldPos;
	return Out;
}//
//--------------------------------------------------------------------------------------
// Hull shader 
// Patch Constant Function
HS_DEFAULT_QUAD_CONSTANT_OUTPUT WaterConstantHS(
	InputPatch<VS_HS_OUTPUT, 4> ip,
	uint patchID : SV_PrimitiveID)
{
	/*float depth = UnpackHeight(sampleLevel2DArray(TX_WATER_HEIGHTMAPS, ip[0].waterMapTC).r) -
		UnpackHeight(sampleLevel2D(TX_WATER_PART_HEIGHTMAP, (ip[0].worldPos.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw).r);
	depth = max(depth, UnpackHeight(sampleLevel2DArray(TX_WATER_HEIGHTMAPS, ip[1].waterMapTC).r) -
		UnpackHeight(sampleLevel2D(TX_WATER_PART_HEIGHTMAP, (ip[1].worldPos.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw).r));
	depth = max(depth, UnpackHeight(sampleLevel2DArray(TX_WATER_HEIGHTMAPS, ip[2].waterMapTC).r) -
		UnpackHeight(sampleLevel2D(TX_WATER_PART_HEIGHTMAP, (ip[2].worldPos.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw).r));
	depth = max(depth, UnpackHeight(sampleLevel2DArray(TX_WATER_HEIGHTMAPS, ip[3].waterMapTC).r) -
		UnpackHeight(sampleLevel2D(TX_WATER_PART_HEIGHTMAP, (ip[3].worldPos.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw).r));

	float2 v[4] = {
		lerp(ip[0].worldPos.xz, ip[2].worldPos.xz, .25f),
		lerp(ip[1].worldPos.xz, ip[3].worldPos.xz, .25f),
		lerp(ip[2].worldPos.xz, ip[0].worldPos.xz, .25f),
		lerp(ip[3].worldPos.xz, ip[1].worldPos.xz, .25f),
	};
	depth = max(depth, UnpackHeight(sampleLevel2DArray(TX_WATER_HEIGHTMAPS, ip[0].waterMapTC).r) -
		UnpackHeight(sampleLevel2D(TX_WATER_PART_HEIGHTMAP, (v[0] - g_vTerrainPosData.xy) * g_vTerrainPosData.zw).r));
	depth = max(depth, UnpackHeight(sampleLevel2DArray(TX_WATER_HEIGHTMAPS, ip[1].waterMapTC).r) -
		UnpackHeight(sampleLevel2D(TX_WATER_PART_HEIGHTMAP, (v[1] - g_vTerrainPosData.xy) * g_vTerrainPosData.zw).r));
	depth = max(depth, UnpackHeight(sampleLevel2DArray(TX_WATER_HEIGHTMAPS, ip[2].waterMapTC).r) -
		UnpackHeight(sampleLevel2D(TX_WATER_PART_HEIGHTMAP, (v[2] - g_vTerrainPosData.xy) * g_vTerrainPosData.zw).r));
	depth = max(depth, UnpackHeight(sampleLevel2DArray(TX_WATER_HEIGHTMAPS, ip[3].waterMapTC).r) -
		UnpackHeight(sampleLevel2D(TX_WATER_PART_HEIGHTMAP, (v[2] - g_vTerrainPosData.xy) * g_vTerrainPosData.zw).r));*/

	HS_DEFAULT_QUAD_CONSTANT_OUTPUT Out;
#if defined(QUALITY_LOW) && !defined(_EDITOR)
	Out.Edges[0] = 1;
	Out.Edges[1] = 1;
	Out.Edges[2] = 1;
	Out.Edges[3] = 1;

	Out.Inside[0] = 1;
	Out.Inside[1] = 1;
#else
	float depth = 1;	
	if (depth > WATER_CLIP_DEPTH) {
		const float tessDistStart = 32.f;
		const float tessDistInterval = 1024.f;
		ComputeDefaultQuadConstant(Out,
			ip[0].worldPos,
			ip[1].worldPos,
			ip[2].worldPos,
			ip[3].worldPos,
			tessDistStart, tessDistInterval);
	} else {
		Out.Edges[0] = 0;
		Out.Edges[1] = 0;
		Out.Edges[2] = 0;
		Out.Edges[3] = 0;

		Out.Inside[0] = 0;
		Out.Inside[1] = 0;
	}
#endif
	return Out;
}

HS_DEFAULT_QUAD_FUNCTION_BEGIN(VS_HS_OUTPUT, waterHS, WaterConstantHS)
	HS_DEFAULT_PASSTHROUGH(worldPos)
HS_DEFAULT_FUNCTION_END

//--------------------------------------------------------------------------------------
// Domain shader
[domain("quad")]
DS_OUTPUT waterDS(HS_DEFAULT_QUAD_CONSTANT_OUTPUT inputConstant,
	float2 uv : SV_DomainLocation,
	const OutputPatch<VS_HS_OUTPUT, 4> inputPatch, out float4 oProjPos : SV_Position)
{
	DS_OUTPUT Out;

	float3 worldPos;
	worldPos = DS_DEFAULT_QUAD_EVALUATE(worldPos);
	// save world pos xz without distortion
	Out.worldPos_w.xz = worldPos.xz;

	float2 terrainTC = (worldPos.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw;	
	worldPos.y = UnpackHeight(sampleLevel2D(TX_TCOMMON_WATERHEIGHTMAP, terrainTC).r);

	float2 simTC = (worldPos.xz - g_vSimSubsetPosData.xy) * g_vSimSubsetPosData.zw;
	float4 waterSim = sampleLevel2D(TX_TCOMMON_WATERSIM, simTC);
	float4 waterMap = sampleLevel2D(TX_TCOMMON_WATERMAP, terrainTC);

	float foamCoef;
	float2 flow;
	GetWaterFoamAndFlow(waterMap, waterSim, foamCoef, flow);
		
	float3 baseNormal = _UP;// UnpackXZNormal(sampleLevel2D(TX_WATER_NORMALS, terrainTC).rg);
	float wavesMip = GetWaterWavesMip(worldPos, baseNormal);

	float3 worldNormal;
	float wavesOffset;
	float wavesFoamHeight;	
	{
		float2 flowDir = normalize(flow);
		float flowSpeed = length(flow);

		float3 localNormal;
		wavesOffset = GetWaves(localNormal, worldNormal, wavesFoamHeight, wavesMip, flowDir, flowSpeed, worldPos, baseNormal, false);

		// raise by foam
		//const float dynamicFoamHeight = .1f;
		//wavesOffset += WATER_SIM_DYNAMIC_FOAM(waterSim) * dynamicFoamHeight;
		const float heigthOffsetRange = 2.f;
		wavesOffset += (WATER_SIM_HEIGHTOFFSET(waterSim) - .50196f) * heigthOffsetRange;
			
#ifndef SHOW_NORMALMAP
		float tOpacity = 1;// saturate(waterDepth * 2.f);
		wavesOffset += saturate(foamCoef * 2.f - .25f) * wavesFoamHeight;

		// dont allow surface go below terrain
		float waterDepth = worldPos.y - UnpackHeight(sampleLevel2D(TX_TCOMMON_HEIGHTMAP, terrainTC).r);
		/*if (waterDepth > 0)*/ {
			wavesOffset = lerp(wavesOffset, max(wavesOffset, -waterDepth + .05f), saturate(waterDepth / .05f));
		}

		const float posDistortionScale = .5f;
		worldPos.y += wavesOffset * tOpacity;
		worldPos.xz -= worldNormal.xz * tOpacity * posDistortionScale * (1.f - wavesFoamHeight);
#endif
	}
	//Out.mud_foam_dedge_hup.z = 0;// 1.f - saturate((length(g_vSimSizeParams.xy - worldPos.xz) - g_vSimSizeParams.z) * g_vSimSizeParams.w);

	// Transform the position from world space to homogeneous projection space
	oProjPos = mul(float4(worldPos, 1), g_tmViewProj);	
	//Out.worldPos_w.xz = worldPos.xz;
	// save adjusted y coordinate
	Out.worldPos_w.y = worldPos.y;	
	Out.worldPos_w.w = oProjPos.w;
	Out.fogColor = ComputeTerrainFog(worldPos);

	SURFACE_DESC surface;
	surface.albedo = float3(1, 1, 1);
	surface.backside = 1.f;
	surface.worldPos = worldPos;
	surface.worldNormal = baseNormal;
	surface.metalness = 0;
	surface.roughness = 0;
	surface.occlusion = 1.f;
	ApplyDefaultOcclusion(surface);
	{
		LIGHTING_DESC lighting;
		DoDefaultLighting(lighting, surface);

		Out.directLight = lighting.directDiffuse;
		Out.ambientLight = lighting.ambientDiffuse;
	}
	/*float lightingMult = 1.f + waves * 2.f * (1.f - foamCoef);
	lightingMult += hoffsetDown * 1.2f;

#ifdef QUALITY_LOW
	Out.directLight_specMult.rgb *= lightingMult;
#endif
	Out.ambientLight_wavesMip.rgb *= lightingMult;*/

	//Out.baseNormal_occlusion.xyz = baseNormal;
	Out.occlusion = surface.occlusion;

	//saturate(/*lightMap1.a + */saturate(WATER_MAP_OPACITY(waterMap) - .2f) / .8f);
	return Out;
}
//--------------------------------------------------------------------------------------
// Pixel shader
// Main
float4 waterPS(const DS_OUTPUT v, in float4 vScreenPos : SV_Position
//#ifdef QUALITY_HIGHEST
//			   , out float4 outColor1 : SV_Target1
//#endif
			   ) : SV_Target0
{	
//#ifdef QUALITY_HIGHEST
//	outColor1 = 0;
//#endif
/*
	{
		const float ambientWindSpeed = 0;// 4.f;
		float3 samplePos;
		samplePos.xz = v.worldPos_w.xz;
		samplePos.y = g_fSceneTime * 16.f;
		float3 noiseTC = samplePos - AMBIENT_WIND_DIRECTION * ambientWindSpeed * g_fSceneTime;

		const float density = .001f;
		float n = sampleLevel3D(TX_TCOMMON_WIND_NOISE, noiseTC * density).r;
		//return max(n - .5f, 0.f) * .1f;
		//return n.b;
		//return length(n-.5f);
	}
*/
	// clip by cutmap
	float2 screenTC = vScreenPos.xy * g_vRTSizeInv;
	ClipByTerrainCutmap(screenTC, v.worldPos_w.xyz);

	float2 terrainTC = (v.worldPos_w.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw;
	float2 simTC = (v.worldPos_w.xz - g_vSimSubsetPosData.xy) * g_vSimSubsetPosData.zw;

	float4 waterSim = sampleLevel2D(TX_TCOMMON_WATERSIM, simTC);
	float4 waterMap = sampleLevel2D(TX_TCOMMON_WATERMAP, terrainTC);	
	//return waterSim.aaaa;
	//return 1;
	float waterDepth = max(v.worldPos_w.y - UnpackHeight(sampleLevel2D(TX_TCOMMON_HEIGHTMAP, terrainTC).r), 0);
	//return float4(waterDepth.xxx, 1);

	float foamCoef;
	float2 flow;
	GetWaterFoamAndFlow(waterMap, waterSim, foamCoef, flow);
	//return float4(WATER_SIM1_DYNAMIC_FOAM(waterSim1).xxx, 1);
	//return float4(WATER_SIM_DISTURBANCE(waterSim), 0, 0);

	float3 localNormal;
	float3 worldNormal;	
	float wavesAlpha;
	float wavesFoam;
	float causticsLod;
	{
		float2 flowDir = normalize(flow);
		float flowSpeed = length(flow);

		float wavesMip = GetWaterWavesMip(v.worldPos_w.xyz, _UP);
		wavesAlpha = GetWaves(localNormal, worldNormal, wavesFoam, wavesMip, flowDir, flowSpeed, v.worldPos_w.xyz, _UP, true);
		causticsLod = 1.f + 5.f * saturate((1.f - flowSpeed / .25f/* - disturbance / .5f*/));

		//foamCoef *= 1.f - worldNormal.y;
	}
	// additional distortion
	//worldNormal.xz += UnpackNormal(sample2D(TX_WATER_WAVES, v.worldPos_w.xz * .05f).rgb).rg * .1f;
	
	#ifdef SHOW_NORMALMAP
		return float4(worldNormal.rgb, 1);
	#endif	
	float screenDepthCenter = sampleLevel2D(TX_COMMON_Z, screenTC).r;

	// generate refraction offset
	float2 reflOffset;
	float2 refrOffset;	
	{		
		float3 __worldNormal = worldNormal;
		// additional refraction distortion
		__worldNormal.xz += UnpackNormal(sample2D(TX_WATER_WAVES, v.worldPos_w.xz * .05f).rgb).rg * .15f;
		float3 viewNormal = mul(float3(__worldNormal.x, 0, __worldNormal.z), (float3x3)g_tmView);		

		#ifndef SIMPLIFIED_SHADING
 			refrOffset = float2(viewNormal.x, viewNormal.z) * .2f;	
 			refrOffset.y -= wavesAlpha * .1f;
			// no refraction distortion in distance (causes aliasing)
			//refrOffset *= saturate(1.5f - pow(v.worldPos_w.w * .05f, .15f));	

			// more refraction in depth
			float depthMult = max(0, screenDepthCenter - v.worldPos_w.w) * .1f;
			// not to sample objects in front of water
			depthMult = min(depthMult, sampleLevel2D(TX_COMMON_Z, screenTC + refrOffset).r - v.worldPos_w.w) * .5f;

			depthMult = saturate(depthMult);	
			depthMult = pow(depthMult, .5f);
			refrOffset *= depthMult;
		#else
			refrOffset = 0;
		#endif

		float3 _worldNormal = localNormal.xzy; // ignore water shape normal for reflections
		// additional reflections distortion
		_worldNormal.xz += UnpackNormal(sample2D(TX_WATER_WAVES, v.worldPos_w.xz * .05f).rgb).rg * .05f;

		float3 _viewNormal = mul(float3(_worldNormal.x, 0, _worldNormal.z), (float3x3)g_tmView);
		reflOffset = float2(-_viewNormal.z, _viewNormal.x) * .25f;	
	}

	// compute water depth
	float3 dirToEye = normalize(g_vEyePos - v.worldPos_w.xyz);
	float depthCorrection = 1.f / dot(-dirToEye, g_vViewDir.xyz);
	float waterDepthScreen;
	{
		float2 refrTC = screenTC + refrOffset;
		float3 frustumViewDirRefr = lerp(
			lerp(g_frustumDirs[0].xyz, g_frustumDirs[1].xyz, 1 - refrTC.y),
			lerp(g_frustumDirs[3].xyz, g_frustumDirs[2].xyz, 1 - refrTC.y),
			refrTC.x);
		float depthCorrectionRefr = 1.f / dot(frustumViewDirRefr, g_vViewDir.xyz);

		float screenDepthRefr = sampleLevel2Dex(TX_COMMON_Z, refrTC, SMP_CLAMP_POINT).r;
		float3 samplePosRefr = g_vEyePos + frustumViewDirRefr * screenDepthRefr * depthCorrectionRefr;
		if (samplePosRefr.y > v.worldPos_w.y) {
			// dont sample refraction that is above water
			screenDepthRefr = screenDepthCenter;
			refrOffset = 0;
		}
		//return float4(refrOffset * 128, 0, 0);
		waterDepthScreen = max(0, screenDepthRefr - v.worldPos_w.w);
		//waterDepthScreen = max(0, screenDepthCenter - v.worldPos_w.w);
		waterDepthScreen *= depthCorrection;
	}	

	float kSoft = 1.f;
	#ifndef QUALITY_LOW
		causticsLod *= waterDepth * .5f;

		float causticsMult = saturate(1.f - waterDepth * .25f) * .75f;
		//float causticsMult = 0.5f;
		kSoft = saturate(waterDepthScreen * 2.f);
	#endif
	//mudCoef = 0;	
	//underwaterFoam = 1;			

	WATERTYPE_PARAMS waterParams;
	GetWaterTypeParams(waterParams, TX_WATER_TYPES_INDICES, TX_WATER_TYPES_BLEND, v.worldPos_w.xz);

	//{
	//	float2 terrainTC = (v.worldPos_w.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw;

	//	// types are per-subblock map so it is mapped correctly
	//	float2 typesIndices = sampleLevel2D(TX_WATER_TYPES_INDICES, terrainTC).rg;
	//	// blends is per-sublock-vertex map so map it properly
	//	float typesBlend = sampleLevel2D(TX_WATER_TYPES_BLEND, terrainTC *
	//		(1.f - TERRAIN_SUBBLOCK_SIZE * g_vTerrainPosData.zw) +
	//		TERRAIN_SUBBLOCK_SIZE * .5f * g_vTerrainPosData.zw).r;

	//	//return float4(typesIndices.xxx * 255.f * 64.f, 1);
	//	//return float4(typesIndices.yyy * 255.f * 64.f, 1);
	//	//return float4(typesIndices.xy * 255.f * 64.f, 0, 1);
	//	//return float4(typesBlend.xxx, 1);
	//}

	// compute water color
	float3 waterColor = waterParams.vDiffuse;	
	float3 foamTint = waterParams.vFoam;
	waterColor = lerp(waterColor, foamTint, /*foamCoef*/0); // Note: foam color disabled
	
	//return float4(wavesFoam.xxx, 0);
	float3 foamColor = foamTint * (.5f + wavesFoam);// lerp(foamTint, wavesFoam * 2.f, wavesFoam * .25f);
	float2 opacityParams = float2(
		-1.f / waterParams.fOpacityDepth, 
		1.f - waterParams.fOpacityBias);
	float shadowmapAtten = GetShadowmapAtten(v.worldPos_w.xyz + float3(worldNormal.x, 0, worldNormal.z) * .5f, true);
	{
		float NdotL = saturate(1.f - dot(worldNormal, dirToEye));
		float3 l = v.directLight * shadowmapAtten * NdotL + v.ambientLight;
		//return float4(l.rgb, 0);
		//l += v.headlight * (1.f - opacityParams.y);

		waterColor *= l;
		foamColor *= l;
	}
	float3 reflColor;
	{
		float3 reflDir = normalize(g_vViewDir.xyz * float3(1.f, 0, 1.f));
		reflDir = -normalize(float3(
			reflDir.x,
			-1.f,
			reflDir.z));
		if (g_fUseRealReflectionDirection) {
			reflDir = dirToEye; // Note: this is the 'correct' reflection direction
		}

		float3 reflectVec = reflect(reflDir, worldNormal);
		reflColor = sampleLevelCube(TX_COMMON_GGXREFLCUBE, -reflectVec).rgb;

#ifndef QUALITY_LOW
		// apply ss reflections
		float4 ssColor = sample2D(TX_WATER_REFLECTIONS, screenTC + reflOffset);
		reflColor = lerp(reflColor, ssColor.rgb, ssColor.a);
#endif
/*
		// apply fresnel
		// WIP: restore refl dir
		reflDir = normalize(g_vViewDir.xyz * float3(1.f, 0, 1.f));
		reflDir = -normalize(float3(
			reflDir.x,
			-1.f,
			reflDir.z));
*/
		//float fresnelFactor = saturate(.04f + .8f * pow(1.f - dot(worldNormal, dirToEye), 8.f));
		float fresnelFactor = saturate(.02f + .2f * pow(1.f - dot(worldNormal, reflDir), 2.f));
		reflColor *= fresnelFactor;

		// apply occlusion
		reflColor *= .5f + v.occlusion * .5f;

		// apply cloaking
		float cloaking = GetCloakingAt(v.worldPos_w.xz);
		reflColor *= saturate((cloaking - .5f) / .5f);

	//	return float4(reflColor.rgb, 1);
	}	
	float3 caustics = 0;
	#ifndef SIMPLIFIED_SHADING
	{
		float3 screenPosWorld = g_vEyePos - dirToEye * screenDepthCenter * depthCorrection;			
		float3 screenPosCaustics = mul(float4(screenPosWorld, 1), g_tmCausticsView).xyz;

		float2 _tc = screenPosCaustics.xy * .1f + worldNormal.xz * .2f;
		#ifndef QUALITY_LOW
			caustics = sampleLevel2D(TX_WATER_CAUSTICS, _tc, causticsLod).rgb * causticsMult;
		#else
			caustics = sample2D(TX_WATER_CAUSTICS, _tc).rgb;
		#endif		
	}
	#endif

	// combining final water color	
	float4 finalColor;
	float waterAlpha;
	#ifdef QUALITY_LOW
		finalColor.rgb = waterColor.rgb + reflColor.rgb;
		finalColor.a = .5f + (1.f - saturate(exp(waterDepth * opacityParams.x) * opacityParams.y)) * .5f;
	#else	
		float3 refrColor = sample2D(TX_WATER_BB_OPAQUE, screenTC + refrOffset).rgb;
		foamColor = lerp(refrColor, foamColor, kSoft);
		{
			float2 tintParams = float2(1.f / waterParams.fTintDepth, waterParams.fTintBias);
			float3 tint = lerp(1.f, 
				waterParams.vRefraction,
				saturate(waterDepthScreen * tintParams.x + tintParams.y));
			refrColor *= tint;
		}		
		waterAlpha = saturate(exp(waterDepthScreen * opacityParams.x) * opacityParams.y/* - foamCoef*/);

		float3 _caustics;
		#ifndef SIMPLIFIED_SHADING
			{
				float3 l = v.ambientLight + v.directLight * shadowmapAtten;
				//l += v.headlight * .4f;
				_caustics = caustics * refrColor * l * kSoft * v.occlusion * .5f;		
			}
		#else
			_caustics = 0;
		#endif

		finalColor.rgb = lerp(waterColor, refrColor + _caustics, waterAlpha) + reflColor.rgb;
		float _l = 0;
		{
			float3 specularDir;
			float specularPower;
			{
/*
				// use camera direction
				specularDir = normalize(g_vViewDir.xyz * float3(1.f, 0, 1.f));
				specularDir = normalize(-float3(
					specularDir.x,
					lerp(4.f, .25f, max(-g_vViewDir.y, EPSILON)),
					specularDir.z));

				// mix with real direction
				float t = .5f;// .5f;// saturate(GetRGBIntensity(g_vSunColor) / .05f);
				specularDir = normalize(lerp(specularDir, g_vSunDir * float3(1.f, .25f, 1.f), t));

				//Out.specularDir_power.xyz = specularDir;
				//Out.specularDir_power.w = lerp(64.f, 1024.f, saturate((-specularDir.y - .15f) / .1f));
*/
				specularDir = normalize(g_vViewDir.xyz * float3(1.f, 0, 1.f));
				specularDir = normalize(-float3(
					specularDir.x,
					16.f,
					specularDir.z));
			}
			//specularDir = normalize(g_vSunDir.xyz * float3(1.f, 8.f, 1.f));
			specularPower = 512.f;	

			float specMult = specularPower * .002f;
//#ifdef NIGHTLIGHTING
//			// hacky night specular
//			specMult *= lerp(1.f, max(1.f - dirToEye.y*2.f, 0.f), g_fLightingMode);
//#endif
			float3 l = v.directLight * shadowmapAtten;
			//l += v.headlight * 2.f;
			l *= /*kSoft * */v.occlusion * (1.f - foamCoef);

			float3 specHalfVector = normalize(dirToEye - specularDir);
			l *= specMult *
				pow(max(0, dot(normalize(worldNormal * float3(1.f, .5f, 1.f)), specHalfVector)), specularPower);
			finalColor.rgb += l;
			_l += max(GetRGBIntensity(l), 0.001f);
		}
		#ifndef SIMPLIFIED_SHADING
			// bloom
			finalColor.a = 1.f / _l * clamp(_l - .5f, 0.f, .5f) * 4.f;
		#else
			finalColor.a = 0;
		#endif		
	#endif	

	//return foam.xxxx;	
	float foamMix = saturate(foamCoef * wavesFoam * 4.f - (1.f - foamCoef) * .5f);
	//foamMix *= kSoft;
	DO_DEBUG_SHADER_OUTPUT(lerp(waterParams.vDiffuse, waterParams.vFoam, foamMix), 1, 0, v.occlusion, finalColor.a);

	//return float4(foamMix.xxx, 1);
	finalColor.rgb = lerp(finalColor.rgb, foamColor, foamMix);
	{
		#ifdef QUALITY_LOW
			float fog = v.fogColor.a * finalColor.a;
		#else
			float fog = v.fogColor.a * (1.f - waterAlpha);
		#endif
		finalColor.rgb = lerp(finalColor.rgb, v.fogColor.rgb, fog);
	}
	//#ifdef QUALITY_HIGHEST
	//	outColor1.rg = (worldNormal.xz + 1.f) / 2.f;
	//	outColor1.b = kSoft;
	//	outColor1.a = 1.f;
	//#endif

	#ifdef _EDITOR
		if (g_fWaterDrawMode == 1.f) {
			// Note: we don't remap layer map but this is neglectable
			float2 externMapTC = (v.worldPos_w.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw;
			return float4(sampleLevel2D(TX_WATER_EXTERN_MAP, externMapTC).rgb, .75f);
		}
		if (g_fWaterDrawMode == 2.f) {
			float opacity = waterDepth / 2.f;
			float3 heat = float3(
				saturate((opacity - .5f) / .5f),
				1.f - abs(opacity - .5f) / .5f,
				1.f - saturate(opacity / .5f));
			return float4(heat, .25f);
		}
	#endif
	//return float4(refrColor.rgb, 1);
	return finalColor;
}//
//--------------------------------------------------------------------------------------

#ifdef _EDITOR
float4 printMapPS(in float4 vScreenPos : SV_Position) : SV_Target0
{
	float2 screenTC = vScreenPos.xy * g_vRTSizeInv;
	float2 worldPosXZ = screenTC / g_vTerrainPosData.zw + g_vTerrainPosData.xy;

	WATERTYPE_PARAMS waterParams;
	GetWaterTypeParams(waterParams, TX_WATER_TYPES_INDICES, TX_WATER_TYPES_BLEND, worldPosXZ);

	float2 terrainTC = (worldPosXZ - g_vTerrainPosData.xy) * g_vTerrainPosData.zw;	
	float3 color = waterParams.vDiffuse;

	float waterDepth =
		UnpackHeight(sampleLevel2D(TX_TCOMMON_WATERHEIGHTMAP, terrainTC).r) -
		UnpackHeight(sampleLevel2D(TX_TCOMMON_HEIGHTMAP, terrainTC).r);
	float waterMask = saturate(waterDepth / .5f);
	return float4(color, waterMask);
}//
//-----------------------------------------------------------------------------
#endif

#endif //__cplusplus

//--------------------------------------------------------------------------------------
// Techniques
//--------------------------------------------------------------------------------------

DECLARE_TECHNIQUE_EX(Color, waterVS, waterHS, waterDS, waterPS);
#ifdef _EDITOR
	DECLARE_TECHNIQUE(PrintMap, passThroughVS, printMapPS);
#endif
//EOF
