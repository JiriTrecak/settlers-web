#ifndef __cplusplus

static float4 g_vAlbedoMult = float4(1, 1, 1, 1); // albedo mult ignored
static float4 g_vShadingParams = float4(0, 0, 0, 1); // shading map/params ignored
//static float4 g_vLightingParams = float4(0, 0, 0, 0);
static float plantSizeY = g_vBrandParams.x;
static float plantSizeXZ = g_vBrandParams.y;
static float plantAnimationType = g_vBrandParams.z;
static float plantFallParam = g_vPlantParams.z;
static float plantFadeOutParam = g_vPlantParams.w;
//static float isDontClipByRoads = g_vBrandParams.x;

#endif

