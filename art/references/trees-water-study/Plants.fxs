// Functions 
void PatchPlantNormals(inout float3 worldNormal, inout float3 worldTangent, in float3 dirToCenter, in float factor) {
	float3 foliageNormal = normalize(dirToCenter + _UP);
	foliageNormal = lerp(_UP, foliageNormal, saturate((plantSizeY - .8f) / 2.6f));
	foliageNormal = normalize(foliageNormal);

	float3 foliageTangent = normalize(cross(foliageNormal, float3(0, 0, 1)));
	worldNormal = lerp(worldNormal, foliageNormal, factor);
	worldTangent = lerp(worldTangent, foliageTangent, factor);
}//
//--------------------------------------------------------------------------------------


static float s_fVertLeafMark;
static float s_fVertLeafDamage;

#ifdef DEBUG_FOLIAGE
static float3 s_vFoliageDebug = 0;
#endif
//static float s_fInstanceTint;
void DoCustomTransform(inout float3 localPos, inout float3 localNormal, inout float3 localTangent, 
	in float2 texCoord, in float4 vertexColor, in float userData, in CUSTOM_BASE_INPUT cbi, in WORLD_TRANSFORM wtm)
{
	const float vertFoliage = vertexColor.a > 0 ? 1.f : 0.f;
	const float3 leafOffset = UnpackNormal(vertexColor.rgb) * PLANT_FOLIAGE_MAX_OFFSET;
	float3 worldPivot = localPos - leafOffset;
	TransformToWorldSpace(worldPivot, wtm);

	float3 dirToCenter = normalize(float3(localPos.x, 0, localPos.z));
	float3 plantOrg;
	float plantObscurance;
	float plantDamage;
	float plantScale;
	#if defined(INSTANCING)      
		plantOrg = wtm.offset.xyz;
		plantObscurance = wtm.userData_scale.b;
		plantDamage = wtm.userData_scale.g;
		plantScale = UnpackScale(wtm.userData_scale.a);
	#else
		plantOrg = g_vInstanceOffset;
		plantObscurance = g_vInstanceParams.x;
		plantDamage = g_vInstanceParams.y;
		plantScale = g_vInstanceParams.z;
	#endif	

	float localY = localPos.y;		
	float3 dummyTangent = 0;
	float3 dummyPos = 0;

	#if defined(SKINNING)
	{
		DoSkinning(localPos, dirToCenter, dummyTangent, wtm.vBoneWeights, wtm.vBoneIndices);
		DoSkinning(dummyPos, localNormal, localTangent, wtm.vBoneWeights, wtm.vBoneIndices);
	}
	#else
	{
		TransformToWorldSpace(localPos, dirToCenter, dummyTangent, wtm);
		TransformToWorldSpace(dummyPos, localNormal, localTangent, wtm);
	}
	#endif

	#ifdef IS_SNAP_TO_TERRAIN
	{
		float3 localUp = _UP;
		TransformToWorldSpace(dummyPos, localUp, dummyTangent, wtm);

		localPos.y = GetTerrainHeight(localPos.xz) + dot(localPos - plantOrg, localUp);
		//localPos.y =
		//	GetTerrainHeight(localPos.xz) + localPos.y - plantOrg.y;
	}
	#else
	{
		float4 bend = sampleLevel2D(TX_TCOMMON_FOLIAGE_BEND, (localPos.xz - g_vVisiblePosData.xy) * g_vVisiblePosData.zw);
		float bendMultiplier = 1.f;
		#ifndef INSTANCING		
			bendMultiplier = 1.f - plantFallParam;
		#endif
		{			
			float topBendFactor = g_vMaterialParams.x;
			float bottomBendFactor = g_vMaterialParams.y;
			float t = (1.f - saturate((localY - 4.f) / 1.f)) * topBendFactor;
			t += saturate(localY / 2.f) * bottomBendFactor;

			float3 offset = float3(0, 0, 0);			
			offset.xz -= UnpackNormal2(bend.rg) * t * vertFoliage * bendMultiplier;

			#ifndef INSTANCING
				// falling foliage collide against terrain
				float h = GetTerrainHeight(localPos.xz) + 1.f;
				offset.y += max(h - localPos.y, 0) * plantFallParam;
			#endif

			float3 l = length(localPos - worldPivot);
			float3 offsetPosStretched = localPos + float3(offset.x, 0, offset.z);
			float3 offsetPosFixed = worldPivot + normalize(offsetPosStretched - worldPivot) * l;

			localPos = offsetPosFixed;
		}
		if (plantAnimationType == PLANT_ANIMATION_TYPE_WIND) {
			{
				// wind animation
				float windMask = saturate(length(leafOffset) / 1.5f) * vertFoliage;
				float stiffness = g_vMaterialParams.z;

				// scale by local y and plant obscurance
				float ambientWindMult = (1.f + localY * plantScale * .1f) * (1.f - stiffness * .5f);
				ambientWindMult *= 1.5f - plantObscurance * 1.f;

				//, saturate((localPos.y - .5f) / 1.5f)
				float3 offset = GetWindOffset(localPos, worldPivot, windMask, ambientWindMult, stiffness);
				offset *= bendMultiplier;
#ifdef _EDITOR
				offset *= g_fEnablePlantsWind;
#endif
				localPos += offset;
			}

			// tree bend
			float bendScale = saturate((plantSizeY * plantScale - 4.f) / 10.f);
			// use absolute coords for bend noise
			float bendPhase = g_fSceneTime + plantOrg.x * .16f + plantOrg.z * .24f;

			const float swingAmplitude = lerp(.0f, .5f, bendScale);
			const float swingFreq = .5f;//lerp(.8f, .1f, bendScale);
			float harmMultiplier = cos(bendPhase * .4f) * cos(bendPhase * .4f * 1.3f);
			{
				float t = bendPhase * swingFreq;
				float bendNoise = harmMultiplier * cos(t * 1.7f) + .25f * sin(t * 4.7f);
				float bendCoef = pow2(saturate(localY / plantSizeY));

				float3 offsetSwing = (AMBIENT_WIND_DIRECTION * bendNoise + AMBIENT_WIND_PERP * harmMultiplier) * swingAmplitude * bendCoef;
				offsetSwing *= bendMultiplier;
#ifdef _EDITOR	
				offsetSwing *= g_fEnablePlantsWind;
#endif
				offsetSwing *= saturate(1.f - plantObscurance); // scale by obscurance

				float3 l = length(localPos - plantOrg);
				float3 offsetPosStretched = localPos + offsetSwing;
				float3 offsetPosFixed = plantOrg + normalize(offsetPosStretched - plantOrg) * l;
				localPos = offsetPosFixed;
			}
		} else if (plantAnimationType == PLANT_ANIMATION_TYPE_WATER) {
			float t = g_fSceneTime * lerp(.25f, .15f, plantScale) + localPos.x * .04f + localPos.z * .06f;
			t += plantOrg.x * .06f + plantOrg.z * .04f;
			localPos.x += sin(t * 3.7f) * .1f;
			localPos.z -= cos(t * 3.7f) * .1f;
			//localPos.y += bendNoise * .1f + .05f;

			// bend ice beneath units
			localPos.y -= bend.b * 2.f;
		}
	}
	#endif
	
	#ifdef DEBUG_FOLIAGE
		//s_vFoliageDebug.rgb = saturate(length(leafOffset) / 2.f) * vertFoliage;
		//s_vFoliageDebug.rgb = leafOffset * vertFoliage;
	#endif
	PatchPlantNormals(localNormal, localTangent, dirToCenter, vertFoliage);

	s_fVertLeafMark = vertexColor.a;

	if (vertFoliage > .5f) {
		// use leaf marks
		s_fVertLeafDamage = plantDamage > vertexColor.a ? 1.f : 0.f;

		// modulate by leaf offset
		float r = plantSizeXZ * .5f / SQRT_2;
		s_fVertLeafDamage *= .2f + min(length(leafOffset) / r, 1.f) * .8f;
	} else {
		s_fVertLeafDamage = plantDamage;
	}
}//
//--------------------------------------------------------------------------------------
void SaveCustomBaseOutput(out CUSTOM_BASE_OUTPUT cbo, out float4 customSurfaceData,
	in float3 localPos, in float3 worldPos, in float userData, in CUSTOM_BASE_INPUT cbi, in WORLD_TRANSFORM wtm)
{
	//float3 tintColor = lerp(TERRAIN_TINT_GRASS, TERRAIN_TINT_DIRT, g_vPlantParams1.x);
	//float tintFactor;
	//#ifdef INSTANCING
	//	cbo.wetness_localY.x = wtm.userData_scale.r;
	//	cbo.wetness_localY.y = localPos.y;
	//	tintFactor = wtm.userData_scale.g;
	//#else
	//	tintFactor = g_vInstanceParams.y;
	//#endif

	//float tintT = (1.f - saturate((localPos.y - 1.f) / 4.f));
	//baseColor.rgb *= lerp(float3(1, 1, 1), tintColor, tintFactor * tintT);
	
	customSurfaceData.x = s_fVertLeafMark;
	customSurfaceData.y = localPos.y;
	customSurfaceData.z = userData; // occlusion
	customSurfaceData.w = s_fVertLeafDamage;

	#ifdef DEBUG_FOLIAGE
		cbo.debug = s_vFoliageDebug;
	#endif
}//
//-------------------------------------------------------------------------------------
void DoCustomSurface(uniform bool isZFill, inout SURFACE_DESC surface, inout float alpha, 
	in float2 texCoord, in TANGENT_SPACE_DATA tsd, in CUSTOM_BASE_OUTPUT cbo, in float4 customSurfaceData, in float2 screenPos, uniform bool isVertexShader)
{	
	#if defined(DEBUG_FOLIAGE)
		surface.albedo.rgb = cbo.debug;
	#endif

	float2 terrainTC = (surface.worldPos.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw;
#ifdef IS_USE_GROUND_COLOR	
	// ground color doesnt work with pervertex lighting properly
	{
		float4 groundMap = sampleLevel2D(TX_TCOMMON_GROUNDMAP, terrainTC);
		//surface.albedo.rgb = surface.albedo.rgb * normalize(groundMap.rgb);
		surface.albedo.rgb *= groundMap.rgb * 2.f;
	}
#endif
#ifdef HAVE_DAMAGED_ALBEDO
	{
		// damaged albedo
		float4 damaged = sample2D(TX_PLANTS_ALBEDO_DAMAGED, texCoord) * g_vAlbedoMult;

		// lerp
		surface.albedo.rgb = lerp(surface.albedo.rgb, damaged.rgb, customSurfaceData.w);
		alpha = lerp(alpha, damaged.a, customSurfaceData.w);
	}
#endif
	
	float vertFoliage = customSurfaceData.x > 0 ? 1.f : 0.f;
	float localY = customSurfaceData.y;
	//float wetness;
	//float localY;
	//#ifdef INSTANCING
	//	wetness = cbo.wetness_localY.x;
	//	localY = cbo.wetness_localY.y;
	//#else
	//	// apply tint
	//	surface.albedo.rgb *= g_vAlbedoMult.rgb;

	//	wetness = g_vInstanceParams.x;
	//	localY = customSurfaceData.z;
	//#endif
	//#ifndef _EDITOR
	//if (isDontClipByRoads > 0) {
	//	float2 terrainTC = (surface.worldPos.xz - g_vTerrainPosData.xy) * g_vTerrainPosData.zw;
	//	float roadsMap = sampleLevel2D(TX_TCOMMON_ROADSMAP, terrainTC).r;
	//	if (roadsMap > .5f && localY < 2.5f) {
	//		// TODO: improve
	//		clip(-1);
	//	}
	//}
	//#endif

	// apply plant vertex occlusion
	surface.occlusion *= customSurfaceData.z;
	/*
	{
		// bend normals towards viewer for larger plants		
		float3 viewerNormal = -g_vViewDir.xyz;
		//viewerNormal.y = max(viewerNormal.y, 0);

		float factor = saturate((plantSizeY - 3.4f) / 5.2f);
		factor = saturate(factor + dot(float4(surface.worldPos, 1), g_vViewDir) / 256.f);		

		// disable specular for plants with bent normals
		s_fDirectSpecularMult = 1 - factor;

		// only bend foliage
		factor *= vertFoliage;

	//	surface.worldNormal = normalize(lerp(surface.worldNormal, viewerNormal, factor * .4f));
		surface.backside = min(surface.backside + factor * .6f, 1.f);
	}	
	*/
	{
		// disable specular for plants with backside lighting
		s_fDirectSpecularMult = max(1 - surface.backside / .5f, 0);
	}
	//{
	//	float height = GetCombinedHeightmapAt(surface.worldPos.xz);
	//	wetness = saturate(wetness - max(surface.worldPos.y - height - 2.f, 0) / 2.f);
	//}
	//ApplyWetness(surface);
	ApplyMacroColor(surface);

	//if (g_vPlantParams2.z > 0) {
	//	ApplyWetness(surface, wetness);		
	//} else {
	//	surface.albedo *= GetWetnessAlbedoMult(saturate(wetness - max(localY - 0, 0) / .5f));
	//}
	#ifndef INSTANCING
		// clip out
		float noise = sample2D(TX_TCOMMON_MICRO_NOISE, texCoord * 1.f).a;
		clip(noise - plantFadeOutParam);
	#endif

	//// desaturate slightly
	//surface.albedo = lerp(surface.albedo.rgb, 
	//	GetRGBIntensity(surface.albedo.rgb).xxx * .5f, saturate((tintFactor - .5f) / .5f) * .5f);	

	if (vertFoliage > 0) {
		// use max shadowmap radius for foliage
		s_fShadowmapFilterRadiusMult = MAX_SHADOWMAP_FILTER_RADIUS_MULT;
	}
#if defined(IS_TRANSPARENT) && !defined(IS_SNAP_TO_TERRAIN) && !defined(_EDITOR)
	// Note: not using additional define because this is rare case
	if (plantAnimationType == PLANT_ANIMATION_TYPE_WATER) {
		// soft depth for water plants
		float2 screenTC = screenPos.xy * g_vRTSizeInv;

		float depth = sampleLevel2D(TX_COMMON_Z, screenTC).r;
		alpha *= saturate((depth - dot(float4(surface.worldPos, 1), g_vViewDir)) / .25f);		
	}
	//surface.albedo.rgb = float3(1, 0, 0);
#endif
}//
